{
  "name": "site-rescue",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Platform-neutral, local-first website migration toolkit",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "lint": "eslint .",
    "audit:dependencies": "pnpm audit --audit-level=low",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "release:prepare": "tsx packages/release-tools/src/cli.ts prepare",
    "release:check": "tsx packages/release-tools/src/cli.ts verify",
    "site-rescue": "tsx apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.2.1",
    "eslint": "^9.33.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^4.1.11"
  }
}
